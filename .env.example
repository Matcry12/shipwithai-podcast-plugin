# Podcast pipeline environment variables.
#
# Copy this file to `.env`, fill in your real values, and source it before
# running the podcast commands:
#
#   cp .env.example .env
#   # edit .env with your values
#   set -a; source .env; set +a    # export every var, run the command, done
#
# `.env` is gitignored — never commit real credentials. These are read from the
# environment only; the skills never write them to any file.

# ── Render server (used by /content-podcast: scripts/call_remote.py) ──────────
# Base URL + bearer token printed by the render server's start.command.
PODCAST_URL=http://localhost:8000
PODCAST_TOKEN=your-render-server-token

# ── Voice cloning (OmniVoice) ────────────────────────────────────────────────
# Each voice is a pair: a mono WAV reference clip (~8–15s, one speaker, no music)
# + its exact transcription (the ref-text — must match the clip, or the clone
# degrades). Supplying the ref-text also skips the server's Whisper pass, cutting
# render time. Keep the WAVs on your local machine — do not commit audio.
#
# DIALOGUE MODE (/content-podcast --mode dialogue) needs BOTH speakers for the
# locale you render: a host pair and a co-host (_2) pair. EN uses PODCAST_EN_*,
# VI uses PODCAST_VI_*. Single-narrator mode uses only the host (_1) pair.

# English — host (voice 1) + co-host (voice 2).
PODCAST_EN_VOICE=/path/to/en-host-ref.wav
PODCAST_EN_REF_TEXT="Transcription of the EN host reference clip."
PODCAST_EN_VOICE_2=/path/to/en-cohost-ref.wav
PODCAST_EN_REF_TEXT_2="Transcription of the EN co-host reference clip."

# Speaker names for the dialogue-mode self-introduction ("I'm Adam." / "and I'm Anna.").
# Optional — if unset, the skill defaults to Adam (host) / Anna (co-host).
PODCAST_HOST_NAME=Adam
PODCAST_COHOST_NAME=Anna

# Vietnamese — host (voice 1) + co-host (voice 2).
PODCAST_VI_VOICE=/path/to/vi-host-ref.wav
PODCAST_VI_REF_TEXT="Transcription of the VI host reference clip."
PODCAST_VI_VOICE_2=/path/to/vi-cohost-ref.wav
PODCAST_VI_REF_TEXT_2="Transcription of the VI co-host reference clip."

# ── Cloudflare R2 (used by /content-podcast-posting: scripts/r2_upload.py) ────
# Only needed for `/content-podcast-posting --backend r2`. The default
# spotify-cowork backend uses your browser session and needs none of these.
# From the Cloudflare dashboard → R2. The API token must be scoped to the bucket.
PODCAST_R2_ACCOUNT_ID=your-cloudflare-account-id
PODCAST_R2_ACCESS_KEY=your-r2-access-key-id
PODCAST_R2_SECRET_KEY=your-r2-secret-access-key
PODCAST_R2_BUCKET=your-bucket-name
# Public base URL of the bucket's bound custom domain (orange-cloud / proxied).
# The final MP3 URL is PODCAST_R2_PUBLIC_BASE/<object-key>. NOT the
# *.r2.cloudflarestorage.com S3 endpoint — that one is the signed API, not public.
PODCAST_R2_PUBLIC_BASE=https://audio.yourdomain.com

# ── Unattended runs (scripts/ci-podcast.sh on a self-hosted runner) ──────────
# These are read by the CI entrypoint and by runner-doctor.sh. On a runner they
# normally live in ~/actions-runner/.env instead, since a systemd service
# inherits nothing from a login shell -- but the same names work here for
# running the pipeline by hand.

# This repo's checkout. Defaults to the directory containing scripts/, so only
# set it when invoking from elsewhere.
#PODCAST_REPO=/home/you/Developer/shipwithai-podcast-plugin

# Leave unset. Empty means the skill auto-detects: omnivoice (cloned voices)
# when the voice clips above are configured, which is the main path. Set only
# as an escape hatch when the render host is unavailable and an episode must
# ship -- kokoro renders preset voices, not yours.
#PODCAST_ENGINE=

# Render->review cycles before halting for a human. `regenerate` re-authors,
# `fix` re-renders the approved script. Three is the tested default.
#PODCAST_MAX_CYCLES=3

# Posts handled per push. A cold queue behind one push should not fire dozens
# of renders.
#PODCAST_MAX_PER_PUSH=3
